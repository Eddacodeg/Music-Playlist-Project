* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: #121212;
  color: #fff;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 20px;
}

h1 {
  font-size: 2rem;
  font-weight: 700;
  color: #1DB954;
  margin-bottom: 8px;
  letter-spacing: 1px;
}

.subtitle {
  color: #b3b3b3;
  font-size: 0.9rem;
  margin-bottom: 32px;
}

.card {
  background-color: #1e1e1e;
  border-radius: 12px;
  padding: 24px;
  width: 100%;
  max-width: 520px;
  margin-bottom: 24px;
}

.card h2 {
  font-size: 1rem;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: #b3b3b3;
  margin-bottom: 16px;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

input[type="text"] {
  background-color: #2a2a2a;
  border: 1px solid #333;
  border-radius: 8px;
  color: #fff;
  font-size: 0.95rem;
  padding: 10px 14px;
  outline: none;
  transition: border 0.2s;
}

input[type="text"]::placeholder {
  color: #666;
}

input[type="text"]:focus {
  border-color: #1DB954;
}

button {
  cursor: pointer;
  border: none;
  border-radius: 8px;
  font-size: 0.9rem;
  font-weight: 600;
  padding: 10px 18px;
  transition: background 0.2s, transform 0.1s;
}

button:active {
  transform: scale(0.97);
}

.btn-add {
  background-color: #1DB954;
  color: #000;
  width: 100%;
  margin-top: 4px;
}

.btn-add:hover {
  background-color: #1ed760;
}

.btn-play {
  background-color: #1DB954;
  color: #000;
  width: 100%;
}

.btn-play:hover {
  background-color: #1ed760;
}

.btn-play:disabled {
  background-color: #3a3a3a;
  color: #666;
  cursor: not-allowed;
}

.btn-remove {
  background-color: transparent;
  color: #b3b3b3;
  border: 1px solid #444;
  padding: 6px 12px;
  font-size: 0.8rem;
  border-radius: 6px;
}

.btn-remove:hover {
  background-color: #e5534b22;
  border-color: #e5534b;
  color: #e5534b;
}

/* Playlist */
#playlist-container {
  width: 100%;
  max-width: 520px;
}

.playlist-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.playlist-header h2 {
  font-size: 1rem;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: #b3b3b3;
}

.song-count {
  font-size: 0.8rem;
  color: #666;
}

.empty-state {
  text-align: center;
  color: #555;
  padding: 40px 0;
  font-size: 0.95rem;
}

.song-item {
  display: flex;
  align-items: center;
  background-color: #1e1e1e;
  border-radius: 8px;
  padding: 12px 16px;
  margin-bottom: 8px;
  transition: background 0.2s;
  gap: 14px;
}

.song-item.playing {
  background-color: #1a3326;
  border: 1px solid #1DB954;
}

.song-index {
  color: #555;
  font-size: 0.85rem;
  min-width: 20px;
  text-align: center;
}

.song-item.playing .song-index {
  color: #1DB954;
}

.song-info {
  flex: 1;
}

.song-title {
  font-size: 0.95rem;
  font-weight: 600;
}

.song-artist {
  font-size: 0.82rem;
  color: #b3b3b3;
  margin-top: 2px;
}

.now-playing-badge {
  font-size: 0.75rem;
  color: #1DB954;
  font-weight: 600;
  margin-left: auto;
  margin-right: 10px;
  white-space: nowrap;
}

/* Now Playing Banner */
#now-playing-banner {
  width: 100%;
  max-width: 520px;
  background-color: #1a3326;
  border: 1px solid #1DB954;
  border-radius: 12px;
  padding: 16px 20px;
  margin-bottom: 24px;
  display: none;
  align-items: center;
  gap: 14px;
}

#now-playing-banner.visible {
  display: flex;
}

.np-icon {
  font-size: 1.6rem;
}

.np-text {
  flex: 1;
}

.np-label {
  font-size: 0.75rem;
  color: #1DB954;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-weight: 600;
}

.np-title {
  font-size: 1rem;
  font-weight: 700;
  margin-top: 2px;
}

.np-artist {
  font-size: 0.85rem;
  color: #b3b3b3;
}

.np-controls {
  display: flex;
  gap: 8px;
}

.btn-next {
  background-color: #2a2a2a;
  color: #fff;
  padding: 8px 14px;
  border-radius: 8px;
  font-size: 0.85rem;
}

.btn-next:hover {
  background-color: #333;
}

.btn-stop {
  background-color: #2a2a2a;
  color: #e5534b;
  padding: 8px 14px;
  border-radius: 8px;
  font-size: 0.85rem;
}

.btn-stop:hover {
  background-color: #3a2020;
}

#finished-msg {
  display: none;
  text-align: center;
  color: #1DB954;
  font-weight: 600;
  font-size: 0.95rem;
  padding: 12px;
  background: #1a3326;
  border-radius: 8px;
  width: 100%;
  max-width: 520px;
  margin-bottom: 24px;
}

#error-msg {
  color: #e5534b;
  font-size: 0.85rem;
  margin-top: 6px;
  min-height: 18px;
}